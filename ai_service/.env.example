# ════════════════════════════════════════════════════════
#  DIU AI Assistant — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ════════════════════════════════════════════════════════

# ── Groq LLM ─────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=300
GROQ_TEMPERATURE=0.1

# ── Qdrant Cloud ─────────────────────────────────────────
# Get from: https://cloud.qdrant.io → your cluster → API Keys
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=diu_knowledge

# ── Scheduler ─────────────────────────────────────────────
# How often (in hours) to re-scrape DIU pages
REFRESH_INTERVAL_HOURS=24

# ── Crawler ───────────────────────────────────────────────
# Entry point URL — crawler starts here and follows all links
CRAWL_START_URL=https://daffodilvarsity.edu.bd/
# Maximum HTML pages to collect per crawl run (higher = more knowledge, slower start)
MAX_CRAWL_PAGES=150
# Maximum link-depth from the start page (4 = up to 4 clicks away)
MAX_CRAWL_DEPTH=4

# ── Security ──────────────────────────────────────────────
# A secret key to protect the /api/refresh endpoint
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REFRESH_SECRET=your_secret_key_here

# ── University ────────────────────────────────────────────
UNIVERSITY_NAME=Daffodil International University
UNIVERSITY_SHORT=DIU
